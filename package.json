{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — 3D third-person game (AI SDLC lab, Day 12). Zero npm dependencies.",
  "scripts": {
    "start": "node scripts/serve.js",
    "headless": "node src/headless.js",
    "test": "node --test tests/*.test.js",
    "proof": "node scripts/proof.js",
    "bench": "node scripts/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc scripts/soak.js --seed 7 --nights 10 --out soak.json",
    "ui-check": "node scripts/ui-check.js",
    "export-leaderboard": "node scripts/serve.js --export-leaderboard leaderboard.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.48.2"
  }
}
